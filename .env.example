# Copia este archivo a `.env` y ajústalo. `.env` no se versiona.
# Con DJANGO_DEBUG=False, DJANGO_SECRET_KEY es obligatoria: sin ella no arranca.
DJANGO_SECRET_KEY=insegura-solo-para-desarrollo
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=gatabase
POSTGRES_USER=gatabase
POSTGRES_PASSWORD=gatabase
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Minutos de inactividad tras los que caduca la sesión. En un mostrador a la
# vista de los Tutores conviene bajarlo; en un box cerrado, subirlo.
GATABASE_MINUTOS_DE_SESION=30

# Dónde esperan las planillas subidas entre la vista previa y la confirmación.
# Se llenan de datos personales, así que en producción quiere ser un disco que
# no se comparta con nadie. Por omisión, `imports/` dentro del proyecto.
GATABASE_DIRECTORIO_DE_IMPORTACIONES=imports
